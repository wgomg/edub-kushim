[Unit]
Description=Kushim Hugot Tag Matcher for %i
Documentation=https://github.com/wgomg/edub-kushim
PartOf=edub-kushim@%i.target
After=network.target

[Service]
Type=notify
NotifyAccess=main
User=%i
Group=%i
Environment=HOME=/home/%i
ExecStart=/usr/local/bin/kushim hugot --socket /home/%i/.config/edub-kushim/kushim-hugot.sock
ExecStop=/bin/kill -s TERM $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

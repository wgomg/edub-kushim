[Unit]
Description=Kushim Batch Queue Daemon
Documentation=https://github.com/wgomg/edub-kushim
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/kushim queue
ExecStop=/bin/kill -s TERM $MAINPID
Restart=on-failure
RestartSec=5

# Security
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes

# Log to journal; application writes its own per-process log under <configDir>/logs/
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

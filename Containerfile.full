FROM ubuntu:26.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    ghostscript \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-spa \
    tesseract-ocr-jpn \
    tesseract-ocr-deu \
    tesseract-ocr-kor \
    unpaper \
    pngquant \
    ocrmypdf \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY dev/bin/kushim /usr/local/bin/kushim
COPY dev/bin/edub   /usr/local/bin/edub

EXPOSE 3001
EXPOSE 8420
